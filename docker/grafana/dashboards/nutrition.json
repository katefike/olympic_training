      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT\n  meal,\n  COUNT(*) AS days,\n  ROUND(AVG(calories)::numeric, 0) AS avg_calories,\n  ROUND(AVG(protein_g)::numeric, 1) AS avg_protein_g,\n  ROUND(AVG(carbohydrates_g)::numeric, 1) AS avg_carbs_g,\n  ROUND(AVG(fat_g)::numeric, 1) AS avg_fat_g\nFROM myfitnesspal.nutrition_meal\nWHERE logged_on BETWEEN $__timeFrom()::date AND $__timeTo()::date\nGROUP BY meal\nORDER BY avg_calories DESC;",
          "refId": "A"
        }
      ],
